#!/usr/bin/env bash

function gpt() {
  (
    # Ensure local shell options so that filename globbing is disabled
    setopt localoptions noglob
    set -f  # Disable globbing
    
    # Change directory to the project's location (adjust path as needed)
    cd $GPT_HOME || {
      echo "Failed to navigate to $GPT_HOME"
      return 1
    }

    # Activate the virtual environment
    source $GPT_HOME/.venv/bin/activate
    
    local has_width=0
    for arg in "$@"; do
      if [[ "$arg" == "--width" ]]; then
        has_width=1
        break
      fi
    done

    if [[ $has_width -eq 0 ]]; then
      local terminal_columns="${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}"
      local terminal_width=$(( terminal_columns > 1 ? terminal_columns - 1 : 1 ))
      python3 $GPT_HOME/cligpt.py --width "$terminal_width" "$@"
    else
      python3 $GPT_HOME/cligpt.py "$@"
    fi
    
    # Deactivate the virtual environment
    deactivate

    # Re-enable globbing after execution
    set +f 
  )
}
